      {
        "blocker": "no exact call insertion point remains without altering selector/producer or note hook ABI; 84-byte leaf cannot validate manifest CRCs and publish 16 slots",
        "name": "exact selector/producer plus SAVE-cave restore leaf"
      },
      {
        "blocker": "0x02005fa4 has no live post-USB safety proof and still needs a wrapper preserving stock 0x020057e0 plus body placement beyond 84 bytes",
        "name": "post-storage boot wrapper plus SAVE-cave body"
      },
      {
        "blocker": "not autonomous or not side-effect-free; repurposing changes UI/default behavior and still lacks CRC/materializer placement",
        "name": "relocated cold UI reload/default-load path"
      },
      {
        "blocker": "explicitly rejected; S1C7 trusted full-length unseeded reads and gave invalid persistent fallback priority over exact S1C5 behavior",
        "name": "S1C7 not-ARMED helper reuse"
      }
    ]
  },
