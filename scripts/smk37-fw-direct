#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TOOL="$PROJECT_ROOT/build/smk37-fw"

if [ ! -x "$TOOL" ]; then
    printf '%s\n' "missing $TOOL; run: make" >&2
    exit 1
fi

# CoreMIDI's per-user MIDIServer normally owns the SMK-37 Pro USB-MIDI
# interface. Terminating it releases the transport for direct libusb access;
# launchd may start it again when the device re-enumerates, so keep releasing
# it until the direct operation has finished.
release_midiserver() {
    pids=$(pgrep -x -u "$UID" MIDIServer 2>/dev/null || true)
    if [ -n "$pids" ]; then
        printf '%s\n' "$pids" | while IFS= read -r pid; do
            kill -TERM "$pid" 2>/dev/null || true
        done
    fi
}

release_midiserver
"$TOOL" "$@" &
tool_pid=$!
trap 'kill -TERM "$tool_pid" 2>/dev/null || true' HUP INT TERM

while kill -0 "$tool_pid" 2>/dev/null; do
    release_midiserver
    sleep 0.1
done

status=0
wait "$tool_pid" || status=$?
trap - HUP INT TERM
exit "$status"
